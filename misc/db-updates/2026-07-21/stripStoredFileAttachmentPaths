#!/usr/bin/php -d mysqlnd.net_read_timeout=3600
<?php
set_include_path("../../../include");
require("header.inc.php");

$apply = !empty($argv[1]) && $argv[1] == 'apply';
$startShardID = empty($argv[2]) ? 1 : $argv[2];

if (!$apply) {
	echo "*** DRY RUN -- pass 'apply' to write changes ***\n\n";
}

$shardIDs = Zotero_DB::columnQuery(
	"SELECT shardID FROM shards S JOIN shardHosts SH USING (shardHostID) "
	. "WHERE S.state='up' AND SH.state='up' AND shardID>=? ORDER BY shardID",
	$startShardID
);

$total = 0;
foreach ($shardIDs as $shardID) {
	echo "Shard: $shardID\n";

	// linkMode 0/1 = imported_file/imported_url (stored-file attachments). Match anything with a
	// separator as a candidate; the precise decision is made in PHP below.
	$rows = Zotero_DB::query(
		"SELECT itemID, libraryID, path FROM itemAttachments JOIN items USING (itemID) "
		. "WHERE linkMode IN (0, 1) AND path LIKE 'storage:%' "
		. "AND (INSTR(path, '/') > 0 OR INSTR(path, 0x5C) > 0)",
		false,
		$shardID
	);
	if (!$rows) {
		continue;
	}

	foreach ($rows as $row) {
		// Work on the raw stored value: separators are ASCII and literal in both the descriptor-
		// encoded and plaintext forms, so the basename needs no decode, and writing via
		// attachmentPath stores it verbatim without changing the encoding. A leaked directory path
		// is a forward slash (never valid in a filename) or a Windows absolute path (drive-letter
		// or UNC prefix); a bare backslash can't be distinguished from a legal filename character
		// (LaTeX, etc.), so it's left alone.
		$rel = substr($row['path'], 8);
		$isPath = strpos($rel, '/') !== false
			|| preg_match('#^[a-zA-Z]:[\\\\/]#', $rel)
			|| substr($rel, 0, 2) == '\\\\';
		if (!$isPath) {
			continue;
		}
		$basename = preg_replace('#^.*[/\\\\]#', '', $rel);
		if ($basename === '' || $basename === $rel) {
			continue;
		}

		$item = Zotero_Items::get($row['libraryID'], $row['itemID']);
		if (!$item) {
			echo "  Item {$row['itemID']} not found -- skipping\n";
			continue;
		}

		echo "  Item {$item->libraryKey}: '$rel' -> '$basename'\n";
		$total++;

		if ($apply) {
			$item->attachmentPath = 'storage:' . $basename;
			$item->save();
		}
	}
}

echo "\n" . ($apply ? "Fixed" : "Would fix") . " $total item(s)\n";
?>
