<?php
/**
 * Request rate/concurrency limits consumed by ApiController::limits()
 *
 * The controller decides which bucket key applies based on the request (auth
 * state, resource, method, query params); this file controls the numbers.
 *
 * Copy to rate_limits.inc.php and tune. The real file is gitignored so tuning
 * changes don't show up in history. If it doesn't exist, this file is loaded
 * as-is.
 *
 * Any bucket key not explicitly listed in $RATES / $CONCURRENCY falls back to
 * the DEFAULT_* constants below. The defaults are deliberately generous (and
 * logOnly) so that unconfigured or newly-added bucket keys fail open -- set
 * per-bucket values in the arrays to enforce.
 */
class Z_CONFIG_RATE_LIMITS {
	// Safety-net fallback for any bucket key not configured in $RATES / $CONCURRENCY below
	const DEFAULT_RATE = ['replenishRate' => 20, 'capacity' => 100, 'logOnly' => true];
	const DEFAULT_CONCURRENCY = ['capacity' => 50, 'ttl' => 120, 'logOnly' => true];

	// Clients on these lists always get real enforcement, even against
	// buckets configured as logOnly. Use to force-enforce against known
	// abusive IPs / user IDs while keeping a bucket observe-only generally.
	public static $ENFORCE_IPS = [];
	public static $ENFORCE_USER_IDS = [];

	// Per-bucket rate limits. Keys correspond to bucket types selected in
	// ApiController::limits():
	//   user_mappings, user_writes, user_tag_searches, user_searches,
	//   user_citation, user_default, anon_mappings, anon_citation,
	//   anon_default, errors_anon, errors_user, user_query_time,
	//   anon_query_time, library_anon_query_time
	//
	// Each entry:
	//   replenishRate: tokens added per second
	//   capacity:      max tokens (burst size)
	//   logOnly:       (optional) true to log over-limit requests without
	//                  rejecting them. Defaults to false (enforce).
	//
	// Buckets not listed here use DEFAULT_RATE.
	//
	// user_query_time and anon_query_time are measured in seconds of DB query
	// time rather than requests. Each request's query time is debited at
	// request end, so the balance can go negative, and requests are rejected
	// while it's zero or below. They catch clients that make expensive
	// requests (e.g., deep 'start' offsets in large libraries) at a rate the
	// request-count buckets allow. A normal client uses well under 1 second
	// of query time per second.
	//
	// Query time is wall-clock time, so a DB slowdown inflates every
	// client's charges. But a request's query time can't exceed its
	// duration, so a client with N requests in flight can't use more than N
	// seconds of query time per second, however slow the DB gets. Keep
	// replenishRate above the concurrency of legitimate clients, so that a
	// slowdown can't get them rejected. Desktop sync makes up to 4 requests
	// at once, and a user can have several devices syncing at once. Clients
	// worth limiting use 10 to 100 times more (e.g., a script with 5 to 10
	// deep pages in flight at 15 to 20 seconds each).
	//
	// library_anon_query_time is a query time bucket per library, charged by
	// all anonymous requests to that library, to catch expensive requests to
	// one public library spread across many IPs. Anonymous use of a public
	// library is normally well under 1 second of query time per second.
	// Because this bucket combines unrelated clients, no single client's
	// concurrency limits it, so a severe DB slowdown can empty it for a busy
	// library.
	//
	// tts_live is used by TTSController::speak() rather than limits(). Its
	// tokens are seconds of synthesized audio, debited after each cache miss,
	// so the balance can go negative. Cache hits aren't counted.
	//
	// Clients can play audio at up to 3x, so a refill of 6 seconds per
	// second leaves 2x headroom. The capacity of 600 (10 minutes of audio)
	// covers bursts from starting a document, seeking, voice switches, and
	// multiple devices.
	public static $RATES = [
		'tts_live' => ['replenishRate' => 6, 'capacity' => 600],
		'user_query_time' => ['replenishRate' => 10, 'capacity' => 600],
		'anon_query_time' => ['replenishRate' => 5, 'capacity' => 300],
		'library_anon_query_time' => ['replenishRate' => 5, 'capacity' => 300],
	];

	// Per-bucket concurrent-request limits. Keys:
	//   user_writes, user_citation, user_default, anon_citation,
	//   anon_default
	//
	// Each entry:
	//   capacity: max in-flight requests
	//   ttl:      seconds a slot is held before auto-release (request
	//             timeout ceiling)
	//   logOnly:  (optional) same semantics as above
	//
	// Buckets not listed here use DEFAULT_CONCURRENCY.
	public static $CONCURRENCY = [];
}
?>
